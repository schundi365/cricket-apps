# Supabase Configuration
# Get these values from your Supabase project settings at https://supabase.com
REACT_APP_SUPABASE_URL=your-project-url-here
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (for testing only - bypasses RLS)
# Get this from: https://supabase.com/dashboard/project/_/settings/api
# WARNING: Keep this secret! Never commit to version control or expose in client-side code
REACT_APP_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
